    market: { gaming: 1, creator: .92, value: 1.14, business: 1.06, efficiency: .9, enthusiast: 1.03, headline: '普及価格帯のPC需要が堅調', weeksRemaining: 12, cpuPool: 7_400, gpuPool: 5_600 },
    notifications: [{ id: 'welcome', title: '会社設立', message: '人材・研究・工場・資金を揃え、最初の世代を市場へ送り出してください。', tone: 'good', date: { year: 2015, week: 1 } }],
