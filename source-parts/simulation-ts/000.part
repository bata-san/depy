  };
}

export function saveState(state: GameState): void {
  if (typeof localStorage !== 'undefined') localStorage.setItem(SAVE_KEY, JSON.stringify(state));
}

export function loadState(): GameState {
  if (typeof localStorage === 'undefined') return createInitialState();
  try {
    const parsed = JSON.parse(localStorage.getItem(SAVE_KEY) ?? 'null') as GameState | null;
    return !parsed || parsed.version !== VERSION ? createInitialState() : parsed;
  } catch {
    return createInitialState();
  }
}

export function resetState(): GameState {
  if (typeof localStorage !== 'undefined') localStorage.removeItem(SAVE_KEY);
  return createInitialState();
}

export function getFacilityLevel(state: GameState, id: FacilityId): number {
  return state.facilities.find((facility) => facility.id === id)?.level ?? 0;
}

function traitCount(state: GameState, trait: StaffMember['traits'][number]): number {
  return state.staff.filter((member) => member.traits.includes(trait)).length;
}

function staffCapability(state: GameState, roles: StaffMember['role'][]): number {
  const relevant = state.staff.filter((member) => roles.includes(member.role));
  if (!relevant.length) return 10;
  return relevant.reduce((sum, member) => sum + member.skill * (member.morale / 100) * (1 - member.fatigue / 150), 0) / relevant.length;
}

function specialtyCapability(state: GameState, specialties: StaffMember['specialty'][]): number {
  const relevant = state.staff.filter((member) => specialties.includes(member.specialty));
  if (!relevant.length) return 0;
  return relevant.reduce((sum, member) => {
    const traitBoost = member.traits.includes('prodigy') ? 1.08 : member.traits.includes('veteran') ? 1.04 : 1;
    return sum + member.skill * (member.morale / 100) * (1 - member.fatigue / 145) * traitBoost;
  }, 0) / relevant.length;
}

function traitPower(state: GameState, trait: StaffMember['traits'][number]): number {
  return state.staff.filter((member) => member.traits.includes(trait)).reduce((sum, member) => sum + member.skill / 100, 0);
}

export function createSeries(state: GameState, name: string, category: ProductCategory, focus: SeriesFocus): { ok: boolean; message: string; series?: ProductSeries } {
  const clean = name.trim();
  if (clean.length < 2) return { ok: false, message: 'シリーズ名を2文字以上にしてください。' };
  const cost = 5_000_000 + state.series.length * 1_200_000;
  if (state.cash < cost + 8_000_000) return { ok: false, message: 'ブランド立ち上げ費と運転資金が不足しています。' };
  const series: ProductSeries = { id: uid('series'), name: clean, category, focus, generation: 0, legacy: 0, brand: 0, active: true, createdAt: copyDate(state.date), lifetimeUnits: 0, lifetimeProfit: 0 };
  state.series.push(series);
  state.selectedSeriesId = series.id;
  ledger(state, `${clean} シリーズ立ち上げ`, -cost, 'marketing');
  notify(state, '新シリーズ開始', `${clean}のブランド開発を開始しました。`, 'good');
  return { ok: true, message: 'シリーズを作成しました。', series };
}

export function availableNodes(state: GameState): number[] {
  const level = state.research.process;
  const nodes = [28];
  if (state.date.year >= 2016 && level >= 2) nodes.push(16);
  if (state.date.year >= 2018 && level >= 3) nodes.push(10);
  if (state.date.year >= 2020 && level >= 4) nodes.push(7);
  if (state.date.year >= 2023 && level >= 5) nodes.push(5);
  if (state.date.year >= 2027 && level >= 6) nodes.push(3);
  return nodes;
}

