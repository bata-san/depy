const SAVE_KEY = 'pc-frontier-lab-v4';
const VERSION = 4;
const clamp = (value: number, min: number, max: number): number => Math.min(max, Math.max(min, value));
const round = (value: number, digits = 1): number => Number(value.toFixed(digits));
const uid = (prefix: string): string => `${prefix}-${Math.random().toString(36).slice(2, 9)}`;
const copyDate = (date: GameDate): GameDate => ({ year: date.year, week: date.week });
const random = <T>(items: T[]): T => items[Math.floor(Math.random() * items.length)] as T;

export function dateToIndex(date: GameDate): number { return date.year * 52 + date.week; }
export function addWeeks(date: GameDate, weeks: number): GameDate {
  const index = dateToIndex(date) + weeks;
  return { year: Math.floor((index - 1) / 52), week: ((index - 1) % 52) + 1 };
}
export function dateLabel(date: GameDate): string { return `${date.year}年 ${date.week}週`; }

function ledger(state: GameState, label: string, amount: number, category: LedgerEntry['category']): void {
  state.ledger.unshift({ id: uid('ledger'), date: copyDate(state.date), label, amount, category });
  state.ledger = state.ledger.slice(0, 400);
  state.cash += amount;
  if (amount > 0 && category === 'sales') state.stats.lifetimeRevenue += amount;
  state.stats.lifetimeProfit += amount;
}

function notify(state: GameState, title: string, message: string, tone: NotificationItem['tone'] = 'info'): void {
  state.notifications.unshift({ id: uid('note'), title, message, tone, date: copyDate(state.date) });
  state.notifications = state.notifications.slice(0, 36);
}

function initialSeries(): ProductSeries[] {
  return [
    { id: 'series-cpu-1', name: 'Frontier Core', category: 'cpu', focus: 'balanced', generation: 0, legacy: 1, brand: 4, active: true, createdAt: { year: 2015, week: 1 }, lifetimeUnits: 0, lifetimeProfit: 0 },
    { id: 'series-gpu-1', name: 'Frontier Graphics', category: 'gpu', focus: 'value', generation: 0, legacy: 0, brand: 2, active: true, createdAt: { year: 2015, week: 1 }, lifetimeUnits: 0, lifetimeProfit: 0 },
  ];
}

function initialCompetitors(): CompetitorCompany[] {
  const companies = createCompetitors();
  for (const source of HISTORICAL_MODELS) {
    const company = companies.find((item) => item.id === source.companyId);
    if (!company) continue;
    company.models.push({
      id: `hist-${source.companyId}-${source.year}-${source.name.replaceAll(' ', '-').toLowerCase()}`,
      companyId: source.companyId,
      name: source.name,
      category: source.category,
      launchDate: { year: source.year, week: source.week },
      endDate: addWeeks({ year: source.year, week: source.week }, 118),
      price: source.price,
      performance: source.performance,
      efficiency: source.efficiency,
      reliability: source.reliability,
      software: source.software,
      brand: source.brand,
      fictional: false,
      salesMomentum: 1,
      marketShare: 0,
    });
  }
  return companies;
}

function initialCandidates(): RecruitCandidate[] {
  return [
    generateCandidate(0, 2015, 'thermal'),
    generateCandidate(0, 2015, 'software'),
    generateCandidate(0, 2015, 'circuit'),
    generateCandidate(0, 2015, 'operations'),
  ];
}

