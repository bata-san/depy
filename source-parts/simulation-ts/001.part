export function availablePackages(state: GameState): PackageType[] {
  const result: PackageType[] = ['monolithic'];
  if (state.research.packaging >= 2) result.push('chiplet');
  if (state.research.packaging >= 5 && state.date.year >= 2022) result.push('stacked');
  return result;
}

export function defaultTechnology(state: GameState): TechnologyPlan {
  const nodes = availableNodes(state);
  return { node: nodes[nodes.length - 1] ?? 28, packageType: availablePackages(state).includes('chiplet') ? 'chiplet' : 'monolithic', riskPosture: 'balanced', softwareInvestment: 42 };
}

export function defaultDesign(state: GameState, series: ProductSeries): DesignValues {
  const architectureLevel = state.research[series.category === 'cpu' ? 'cpuArchitecture' : 'gpuArchitecture'];
  const legacy = series.legacy;
  const values: DesignValues = {
    computeScale: clamp(30 + architectureLevel * 3.4 + legacy * 1.8, 20, 68),
    clockTarget: clamp(34 + architectureLevel * 2.5 + legacy * 1.2, 20, 66),
    architecture: clamp(32 + architectureLevel * 3.5 + legacy * 2.2, 20, 70),
    cacheBandwidth: clamp(34 + architectureLevel * 2.6 + state.research.packaging * 1.8, 20, 68),
    powerBudget: 46,
    qualityFocus: 53,
  };
  if (series.focus === 'performance') { values.computeScale += 7; values.clockTarget += 8; values.powerBudget += 10; values.qualityFocus -= 5; }
  if (series.focus === 'value') { values.computeScale -= 6; values.clockTarget -= 4; values.architecture -= 5; values.qualityFocus -= 3; }
  if (series.focus === 'efficient') { values.clockTarget -= 7; values.powerBudget -= 12; values.architecture += 5; values.qualityFocus += 5; }
  if (series.focus === 'reliable') { values.clockTarget -= 5; values.qualityFocus += 14; values.powerBudget -= 5; }
  for (const key of Object.keys(values) as (keyof DesignValues)[]) values[key] = clamp(values[key], 10, 100);
  return values;
}

export function designCaps(state: GameState, series: ProductSeries): Record<keyof DesignValues, number> {
  const architectureLevel = state.research[series.category === 'cpu' ? 'cpuArchitecture' : 'gpuArchitecture'];
  const era = clamp(state.date.year - 2015, 0, 24);
  const legacy = series.legacy;
  const architectureLab = getFacilityLevel(state, 'architectureLab');
  const validation = getFacilityLevel(state, 'validationLab');
  return {
    computeScale: clamp(52 + architectureLevel * 5 + era * .85 + legacy * 1.6 + architectureLab * 1.5, 52, 100),
    clockTarget: clamp(54 + architectureLevel * 4 + era * .72 + legacy * 1.1 + architectureLab, 54, 100),
    architecture: clamp(50 + architectureLevel * 5.3 + era * .95 + legacy * 1.9 + architectureLab * 1.6, 50, 100),
    cacheBandwidth: clamp(52 + architectureLevel * 4.2 + state.research.packaging * 2.3 + era * .78 + legacy * 1.3, 52, 100),
    powerBudget: clamp(64 + architectureLevel * 2.2 + era * .55, 64, 100),
    qualityFocus: clamp(62 + state.research.manufacturing * 3.2 + validation * 3 + legacy, 62, 100),
  };
}

function packageEffects(packageType: PackageType): { performance: number; multi: number; die: number; yield: number; cost: number; thermals: number; risk: number; single: number } {
  if (packageType === 'chiplet') return { performance: 1.02, multi: 1.1, die: .82, yield: 9, cost: 1.14, thermals: 3, risk: 9, single: .97 };
  if (packageType === 'stacked') return { performance: 1.11, multi: 1.08, die: .78, yield: 3, cost: 1.34, thermals: 11, risk: 18, single: 1.08 };
  return { performance: 1, multi: 1, die: 1, yield: 0, cost: 1, thermals: 0, risk: 0, single: 1.02 };
}

export function calculateMetrics(state: GameState, series: ProductSeries, values: DesignValues, technology: TechnologyPlan): TechnicalMetrics {
  const architectureLevel = state.research[series.category === 'cpu' ? 'cpuArchitecture' : 'gpuArchitecture'];
  const processLevel = state.research.process;
  const softwareLevel = state.research.software;
  const manufacturingLevel = state.research.manufacturing;
  const architectureExpertise = specialtyCapability(state, ['architecture']);
  const clockExpertise = specialtyCapability(state, ['clock']);
  const cacheExpertise = specialtyCapability(state, ['cache']);
  const yieldExpertise = specialtyCapability(state, ['yield']);
  const powerExpertise = specialtyCapability(state, ['power']);
  const driverExpertise = specialtyCapability(state, ['driver']);
  const qualityExpertise = specialtyCapability(state, ['quality']);
  const pragmaticPower = traitPower(state, 'pragmatic');
  const meticulousPower = traitPower(state, 'meticulous');
  const veteranPower = traitPower(state, 'veteran');
  const yearFactor = (state.date.year - 2015) * 6.4;
  const base = series.category === 'cpu' ? 66 : 72;
  const scale = values.computeScale / 100;
  const clock = values.clockTarget / 100;
  const arch = values.architecture / 100;
  const feed = values.cacheBandwidth / 100;
  const power = values.powerBudget / 100;
  const quality = values.qualityFocus / 100;
  const nodeGain = clamp(Math.pow(28 / technology.node, .19), 1, 1.55);
  const packageFx = packageEffects(technology.packageType);
  const posture = technology.riskPosture === 'aggressive' ? 1.1 : technology.riskPosture === 'conservative' ? .94 : 1;
  const postureRisk = technology.riskPosture === 'aggressive' ? 16 : technology.riskPosture === 'conservative' ? -9 : 0;
  const postureCost = technology.riskPosture === 'aggressive' ? 1.16 : technology.riskPosture === 'conservative' ? .96 : 1;
  const starvation = clamp(scale * .72 + clock * .3 - feed - arch * .08 - cacheExpertise * .0019, 0, .52);
  const thermalPressure = clamp(scale * .36 + clock * .52 + power * .26 - quality * .2 - powerExpertise * .0017 + (nodeGain - 1) * -.18, 0, 1.25);
  const teamArchitecture = staffCapability(state, ['architect', 'circuit']);
  const teamQuality = staffCapability(state, ['validation', 'thermal']);
  const performanceRaw = base + yearFactor + architectureLevel * 7.6 + series.legacy * 2.4 + teamArchitecture * .24 + architectureExpertise * .17 + clockExpertise * clock * .16 + cacheExpertise * feed * .11 + (scale * 68 + clock * 62 + arch * 88 + feed * 39) * (1 - starvation * .75);
  const performance = performanceRaw * nodeGain * packageFx.performance * posture;
  const singlePerformance = performance * (.68 + clock * .25 + arch * .18) * packageFx.single;
  const multiPerformance = performance * (series.category === 'cpu' ? 1.08 + scale * .5 : 1.02 + scale * .62) * packageFx.multi;
  const efficiency = clamp(43 + arch * 37 + quality * 16 + architectureLevel * 2.4 + processLevel * 3.2 + nodeGain * 10 + powerExpertise * .11 - thermalPressure * 33 - power * 13, 18, 99);
  const reliability = clamp(50 + quality * 45 + teamQuality * .18 + qualityExpertise * .12 + meticulousPower * 1.8 + manufacturingLevel * 2.4 - clock * 17 - thermalPressure * 11 - postureRisk * .28, 22, 99);
  const softwareQuality = clamp(43 + softwareLevel * 6 + technology.softwareInvestment * .38 + staffCapability(state, ['software']) * .25 + driverExpertise * .14 + getFacilityLevel(state, 'softwareLab') * 4, 28, 99);
  const thermals = clamp(43 + thermalPressure * 57 - quality * 11 + packageFx.thermals - (nodeGain - 1) * 13, 31, 116);
  const dieSize = clamp((68 + scale * 285 + feed * 82 + arch * 48) / nodeGain * packageFx.die, 42, 650);
  const complexityBase = (scale + clock + arch + feed + power) / 5;
  const complexity = clamp(complexityBase * 74 + packageFx.risk + postureRisk + (nodeGain - 1) * 18, 18, 100);
  const yieldRate = clamp(94 - dieSize / 10.7 - complexity * .13 + quality * 17 + yieldExpertise * .12 + meticulousPower * 1.25 + manufacturingLevel * 2.2 + packageFx.yield + getFacilityLevel(state, 'validationLab') * .8, 18, 96);
  const waferFactor = 1 + (nodeGain - 1) * 1.9;
  const unitCost = clamp(((series.category === 'cpu' ? 7_800 : 11_500) + dieSize * 73 + quality * 8_500 + architectureLevel * 1_900) * packageFx.cost * waferFactor, 18_000, 260_000);
  const developmentCost = (7_500_000 + arch * 24_000_000 + scale * 16_000_000 + architectureLevel * 1_900_000 + series.generation * 1_800_000) * postureCost * (1 + (nodeGain - 1) * .45) * clamp(1 - pragmaticPower * .018, .88, 1);
  const maskCost = (3_500_000 + dieSize * 24_000 + processLevel * 1_200_000) * waferFactor;
  const prototypeCost = (1_900_000 + complexity / 100 * 5_500_000) * (1 - getFacilityLevel(state, 'prototypeLab') * .045);
  const validationCost = (1_600_000 + quality * 4_600_000 + clock * 2_600_000 + complexity / 100 * 2_200_000) * (1 - getFacilityLevel(state, 'validationLab') * .035);
  const softwareCost = 1_200_000 + technology.softwareInvestment * 105_000 + softwareLevel * 450_000;
  const scheduleWeeks = clamp(Math.round(34 + complexity * .26 + packageFx.risk * .38 - teamArchitecture * .08 - architectureExpertise * .035 - pragmaticPower * .8 - getFacilityLevel(state, 'architectureLab') * 1.4), 24, 72);
