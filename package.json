{
  "name": "pc-frontier-lab",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "TypeScript and Three.js PC hardware company management simulation",
  "scripts": {
    "prepare:source": "node scripts/assemble.mjs",
    "dev": "npm run prepare:source && vite",
    "typecheck": "npm run prepare:source && tsc --noEmit",
    "build": "npm run prepare:source && tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  }
}
